---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import SkipMain from '../../components/SkipMain.astro';
import NavMain from '../../components/NavMain.astro';
import FeatureItem from '../../components/FeatureItem.astro';
import FadeInUp from '../../components/Animations/FadeInUp';
import ReviewGrid from '../../components/ReviewGrid.astro';
import FooterMain from '../../components/FooterMain.astro';
import FAQHome from '../../components/FAQHome.astro';

export const getStaticPaths = async () => {
  const serviceEntries = await getCollection('service');
  return serviceEntries.map((service: CollectionEntry<'service'>) => ({
    params: { slug: service.slug },
    props: service.data,
  }));
};

interface ServiceProps {
  pageTitle: { pre: string; highlight: string; post: string; };
  seoTitle?: string;
  seoDescription?: string;
  description: string;
  quoteLink?: string;
  aboutTitle?: { line1: string; line2Pre?: string; highlight: string; line2Post?: string; };
  aboutServices: string;
  serviceName: string;
  benefits: { text1: string; text2: string; text3: string; }[];
  comparisonCards?: { title: string; description: string; }[];
  midpageTitle?: { line1: string; highlight: string; line2: string; };
  faqs?: { question: string; answer: string; }[];
  finalCtaTitle?: { line1: string; highlight: string; afterHighlight?: string; line2: string; };
  benefitImg: string;
  image: string;
  headerImg: string;
  category: string | string[];
}

const {
  pageTitle,
  seoTitle,
  seoDescription,
  description,
  serviceName,
  image,
  aboutTitle,
  aboutServices,
  benefitImg,
  headerImg,
  benefits,
  comparisonCards,
  midpageTitle,
  faqs,
  finalCtaTitle,
  quoteLink,
  category,
} = Astro.props as ServiceProps;

const siteUrl = Astro.site ?? new URL('https://www.mooreinsure.net');
const serviceUrl = new URL(Astro.url.pathname, siteUrl).href;
const serviceId = `${serviceUrl}#service`;
const categories = Array.isArray(category) ? category : [category];
const categoryInfo = categories.includes('Personal Coverage')
  ? { name: 'Personal Insurance', path: '/personal/' }
  : categories.includes('Auto Coverage')
    ? { name: 'Auto & Vehicle Insurance', path: '/auto/' }
    : categories.includes('Business Coverage')
      ? { name: 'Business Insurance', path: '/business/' }
      : undefined;
const serviceBreadcrumbs = [
  { name: 'Home', path: '/' },
  ...(categoryInfo ? [categoryInfo] : []),
  { name: serviceName, path: Astro.url.pathname },
];
const serviceSchema = {
  "@type": "Service",
  "@id": serviceId,
  name: serviceName,
  serviceType: serviceName,
  description: seoDescription ?? description,
  url: serviceUrl,
  image: new URL(image, siteUrl).href,
  provider: { "@id": `${new URL('/', siteUrl).href}#organization` },
  areaServed: { "@type": "AdministrativeArea", name: "Arizona" },
};

const resolvedAboutTitle = aboutTitle ?? {
  line1: 'Your Peace of',
  line2Pre: 'Mind',
  highlight: 'Starts',
  line2Post: 'Here',
};

const resolvedComparisonCards = comparisonCards ?? [
  {
    title: 'Compare Top Providers',
    description: 'Moore Insurance shops multiple trusted insurance companies on your behalf—so you get better pricing and a policy that fits your needs.',
  },
  {
    title: 'Personalized Policy',
    description: 'We take time to understand your risks and needs—then recommend coverage that actually protects what matters most.',
  },
  {
    title: 'Ongoing Support',
    description: "From reviewing policies to helping with claims, we're here to provide you with real answers and real peace of mind.",
  },
];

const resolvedMidpageTitle = midpageTitle ?? {
  line1: 'Start',
  highlight: 'Protecting',
  line2: 'What Matters',
};

const resolvedFinalCtaTitle = finalCtaTitle ?? {
  line1: "Let's",
  highlight: 'Find',
  afterHighlight: 'Your',
  line2: 'Perfect Policy',
};

// Determine the quote URL based on the service's category (or use a provided quoteLink)
let quoteUrl = "";
if (quoteLink) {
  quoteUrl = quoteLink;
} else if (typeof category === "string") {
  if (category === "Personal Coverage") {
    quoteUrl = "/quote/personal/";
  } else if (category === "Auto Coverage") {
    quoteUrl = "/quote/auto/";
  } else if (category === "Business Coverage") {
    quoteUrl = "/quote/business/";
  } else {
    quoteUrl = "/quote";
  }
} else if (Array.isArray(category)) {
  if (category.includes("Personal Coverage")) {
    quoteUrl = "/quote/personal/";
  } else if (category.includes("Auto Coverage")) {
    quoteUrl = "/quote/auto/";
  } else if (category.includes("Business Coverage")) {
    quoteUrl = "/quote/business/";
  } else {
    quoteUrl = "/quote";
  }
}
---
<!DOCTYPE html>
<html lang="en">
  <BaseHead
    title={seoTitle ?? `${pageTitle.pre} ${pageTitle.highlight} ${pageTitle.post}`}
    description={seoDescription ?? description}
    image={image}
    breadcrumbs={serviceBreadcrumbs}
    faqs={faqs}
    structuredData={serviceSchema}
    primaryEntityId={serviceId}
  />
  <body>
    <SkipMain />
    <header>
      <NavMain />
    </header>
    <main>
      <!-- Hero Section -->
      <section class="hero-sub" role="banner">
        <div class="padding-hero">
          <div class="container">
            <div class="wrapper-center">
              <FadeInUp delay={0.125} duration={1} client:load>
                <h1 class="page-title center">
                  {pageTitle.pre} <span class="highlight">{pageTitle.highlight}</span> {pageTitle.post}
                </h1>
              </FadeInUp>
              <FadeInUp delay={0.25} duration={1} client:load>
                <p class="body-regular center">
                  {description}
                </p>
                <div class="wrapper-btn center">
                  <a class="btn" href={quoteUrl}>Get Your Free Quote</a>
                </div>
              </FadeInUp>
            </div>
          </div>
        </div>
      </section>

      <!-- Header Image Section -->
      <section>
        <div class="padding-section">
          <div class="container">
            <img src={headerImg} alt={serviceName} class="svc-header-img" />
          </div>
        </div>
      </section>

      <!-- About Services Section -->
      <FadeInUp delay={0.25} duration={1} client:load>
        <section>
          <div class="padding-section">
            <div class="container">
              <div class="wrapper-col">
                <div class="wrapper">
                  <h2 class="section-title">
                    {resolvedAboutTitle.line1}<br />
                    {resolvedAboutTitle.line2Pre} <span class="highlight">{resolvedAboutTitle.highlight}</span> {resolvedAboutTitle.line2Post}
                  </h2>
                  <p class="body-regular">
                    {aboutServices}
                  </p>
                  <div class="wrapper-feature vertical">
                    <FeatureItem title={benefits[0]?.text1} />
                    <FeatureItem title={benefits[0]?.text2} />
                    <FeatureItem title={benefits[0]?.text3} />
                  </div>
                  <div class="wrapper-btn">
                    <a class="btn" href={quoteUrl}>Get Your Free Quote</a>
                  </div>
                </div>
                <img src={benefitImg} alt={serviceName} class="img-reg short" />
              </div>
              <div class="wrapper-col padding-top">
                <div class="card">
                  <h3 class="title-card center">{resolvedComparisonCards[0].title}</h3>
                  <p class="body-regular center">
                    {resolvedComparisonCards[0].description}
                  </p>
                </div>
                <div class="card">
                  <h3 class="title-card center">{resolvedComparisonCards[1].title}</h3>
                  <p class="body-regular center">
                    {resolvedComparisonCards[1].description}
                  </p>
                </div>
                <div class="card">
                  <h3 class="title-card center">{resolvedComparisonCards[2].title}</h3>
                  <p class="body-regular center">
                    {resolvedComparisonCards[2].description}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </FadeInUp>

      <!-- Call to Action Section -->
      <section class="city-bg">
        <div class="padding-section">
          <div class="container">
            <div class="wrapper-center">
              <h2 class="page-title center">
                {resolvedMidpageTitle.line1} <span class="highlight">{resolvedMidpageTitle.highlight}</span><br />
                {resolvedMidpageTitle.line2}
              </h2>
              <div class="wrapper-btn short-padding">
                <a class="btn" href={quoteUrl}>Get Your Free Quote</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Reviews Section -->
      <FadeInUp delay={0.125} duration={1} client:load>
        <section>
          <div class="padding-section">
            <div class="container">
              <ReviewGrid />
              <div class="wrapper-center">
                <div class="wrapper-btn">
                  <a class="btn" href={quoteUrl}>Get Your Quote</a>
                  <a class="btn secondary" href="https://www.google.com/search?client=opera&q=moore+insurance&sourceid=opera&ie=UTF-8&oe=UTF-8" target="_blank" rel="noopener noreferrer">                    Leave Us A Review</a>
                </div>
              </div>
            </div>
          </div>
        </section>
      </FadeInUp>

      <!-- FAQ Section -->
      <FadeInUp delay={0.125} duration={1} client:load>
        <section class="section-main">
          <div class="padding-section">
            <div class="container">
              <div class="wrapper-center">
                <h2 class="section-title center">
                  Some <span class="highlight">Frequently</span><br />
                  Asked Questions
                </h2>
                <FAQHome faqs={faqs} />
              </div>
            </div>
          </div>
        </section>
      </FadeInUp>

      <!-- Final Call-to-Action -->
      <FadeInUp delay={0.125} duration={1} client:load>
        <section>
          <div class="padding-section lg-bottom">
            <div class="container">
              <div class="wrapper-center">
                <h2 class="page-title center">
                  {resolvedFinalCtaTitle.line1} <span class="highlight">{resolvedFinalCtaTitle.highlight}</span> {resolvedFinalCtaTitle.afterHighlight}<br />
                  {resolvedFinalCtaTitle.line2}
                </h2>
                <div class="wrapper-btn short-padding">
                  <a class="btn" href={quoteUrl}>Get Your Free Quote</a>
                </div>
              </div>
            </div>
          </div>
        </section>
      </FadeInUp>
    </main>
    <FooterMain />
  </body>
</html>
