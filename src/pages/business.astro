---
import BaseHead from "../components/BaseHead.astro"
import SkipMain from "../components/SkipMain.astro"
import NavMain from "../components/NavMain.astro"
import AnimatedHeadline from "../components/Animations/AnimatedHeadline"
import FadeInUp from "../components/Animations/FadeInUp"
import FeatureItem from "../components/FeatureItem.astro"
import ServiceGrid from "../components/ServiceGrid.astro"
import ReviewGrid from "../components/ReviewGrid.astro"
import FooterMain from "../components/FooterMain.astro"
import FormBusiness from "../components/FormBusiness.astro"
---
<!DOCTYPE html>
<html lang="en">
  <BaseHead
    title="Business Insurance in Arizona | Moore Insurance"
    description="Explore business insurance options with Moore Insurance in Surprise, AZ. Compare general liability, commercial property, workers' comp and more."
    image="/images/static/business-insurance.webp"
    pageType="CollectionPage"
    breadcrumbs={[{ name: "Home", path: "/" }, { name: "Business Insurance", path: "/business/" }]}
  />
  <body>
    <SkipMain />
    <header>
      <NavMain />
    </header>
    <main>
        <section class="hero-sub-2" role="banner">
            <div class="padding-hero">
                <div class="container">
                    <div class="wrapper-hero">
                        <AnimatedHeadline client:load>
                            Business <span class="highlight">Insurance</span> in Arizona
                        </AnimatedHeadline>
                        <FadeInUp delay={0.5} duration={1} client:load>
                            <div class="wrapper-short">
                                <p class="body-regular">
                                  Moore Insurance helps Arizona business owners compare insurance options for liability, property, employees, vehicles, and other business risks. Based in Surprise, our independent agency works with multiple insurance companies to help businesses review available coverage, policy limits, deductibles, and rates.
                                </p>
                                <div class="wrapper-btn">
                                    <a class="btn" href="/quote/business/">
                                        Get Your Free Quote
                                    </a>
                                    <a class="btn secondary" href="#coverage">
                                        See Coverage Options
                                    </a>
                                </div>
                            </div>
                        </FadeInUp>
                    </div>
                </div>
            </div>
        </section>
        <FadeInUp delay={0.125} duration={1} client:load>
            <section class="section-main">
              <div class="padding-section">
                <div class="container">
                  <div class="wrapper-col">
                    <div class="wrapper">
                      <h2 class="section-title">
                        Why Choose Moore Insurance
                        <br />
                        for <span class="highlight">Business Coverage?</span>
                      </h2>
                      <FeatureItem
                        title="Insurance for Your Business Operations"
                        desc="Your industry, employees, property, and daily operations can affect your insurance needs. We help you review coverage options based on how your business operates."
                      />
                      <FeatureItem
                        title="Compare Coverage and Costs"
                        desc="We compare available policies from multiple insurance carriers and explain differences in premiums, coverage limits, deductibles, and exclusions."
                      />
                      <FeatureItem
                        title="Local Agents, Ongoing Support"
                        desc="Our team in Surprise can help answer questions, review policy changes, and explain the next steps when your business needs assistance with a claim."
                      />
                      <div class="wrapper-btn">
                        <a class="btn" href="/quote/business/">
                          Get Your Quote
                        </a>
                        <a class="btn secondary" href="#coverage">
                          Coverage Options
                        </a>
                      </div>
                    </div>
                    <div class="wrapper-img">
                      <img class="img-reg" src="/images/static/city-2.webp" alt="A modern light rail train with a “TBOUND PHOENIX” sign approaches a station on a bustling city street, surrounded by tall reflective buildings." />
                    </div>
                </div>
              </div>
            </section>
        </FadeInUp>
        <FadeInUp delay={0} duration={1} client:load>
          <section id="coverage">
            <div class="padding-section">
                <div class="container">
                  <div class="wrapper-center">
                    <h2 class="section-title">
                      Explore Our <span class="highlight">Business Insurance</span> Options
                    </h2>
                  </div>
                  <ServiceGrid
                    categoryFilter="Business Coverage"
                    titleOverrides={{
                      "commercial-auto": "Commercial Auto Insurance",
                      "commercial-umbrella": "Commercial Umbrella Insurance",
                      "commercial-property": "Commercial Property Insurance",
                      "general-liability": "General Liability Insurance",
                      "workers-comp": "Workers' Compensation Insurance",
                    }}
                  />
                  <div class="wrapper-btn center">
                    <a class="btn" href="/quote/business/">Get Your Quote</a>
                  </div>
                </div>
            </div>
          </section>
        </FadeInUp>
        <FadeInUp delay={0.125} duration={1} client:load>
          <section>
            <div class="padding-section">
              <div class="container">
                <div class="wrapper-center">
                  <h2 class="section-title center">
                    What Does <span class="highlight">Business Insurance</span> Cover?
                  </h2>
                  <p class="body-regular center">
                    Business insurance includes several types of policies that address different risks associated with operating a business. General liability insurance can help cover certain third-party injury and property damage claims, while commercial property insurance can cover damage to insured buildings, equipment, and other business property. Workers' compensation, commercial auto, cyber insurance, and umbrella policies address other types of risks. Coverage needs depend on your industry, operations, employees, and business assets. Policy terms, limits, and exclusions determine what is covered.
                  </p>
                </div>
              </div>
            </div>
          </section>
        </FadeInUp>
        <section class="city-bg">
          <div class="padding-section">
            <div class="container">
              <div class="wrapper-center">
                <h2 class="page-title center">
                  Compare <span class="highlight">Business Insurance</span>
                  <br />
                  Options
                </h2>
                <div class="wrapper-btn short-padding">
                  <a class="btn" href="/quote/business/">
                    Get Your Quote
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
        <FadeInUp delay={0.125} duration={1} client:load>
          <section>
            <div class="padding-section">
              <div class="container">
                <ReviewGrid
                />
                <div class="wrapper-center">
                  <div class="wrapper-btn">
                    <a class="btn" href="/quote/business/">
                      Get Your Free Quote
                    </a>
                    <a class="btn secondary" href="https://www.google.com/search?client=opera&q=moore+insurance&sourceid=opera&ie=UTF-8&oe=UTF-8" target="_blank" rel="noopener noreferrer">                      Leave Us A Review
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </FadeInUp>
        <FadeInUp delay={0.125} duration={1} client:load>
          <div class="padding-section lg-bottom">
            <div class="container">
              <h2 class="section-title center">
                Get Your <span class="highlight">Free</span> Quote
              </h2>
              <FormBusiness
                coverageLabels={{
                  generalLiability: "General Liability Insurance",
                  commercialAuto: "Commercial Auto Insurance",
                  commercialProperty: "Commercial Property Insurance",
                  workersComp: "Workers' Compensation Insurance",
                  commercialUmbrella: "Commercial Umbrella Insurance",
                }}
              />
            </div>
          </div>
        </FadeInUp>
    </main>
    <FooterMain />
  </body>
