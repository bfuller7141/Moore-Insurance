---
import BaseHead from "../components/BaseHead.astro"
import SkipMain from "../components/SkipMain.astro"
import NavMain from "../components/NavMain.astro"
import AnimatedHeadline from "../components/Animations/AnimatedHeadline"
import FadeInUp from "../components/Animations/FadeInUp"
import FeatureItem from "../components/FeatureItem.astro"
import ServiceGrid from "../components/ServiceGrid.astro"
import ReviewGrid from "../components/ReviewGrid.astro"
import FormPersonal from "../components/FormPersonal.astro"
import FooterMain from "../components/FooterMain.astro"
---
<!DOCTYPE html>
<html lang="en">
  <BaseHead
    title="Personal Insurance in Arizona | Moore Insurance"
    description="Explore home, renters, life and umbrella insurance with Moore Insurance in Surprise, AZ. Compare personal insurance options with our local agents."
    image="/images/static/home-insurance.webp"
    pageType="CollectionPage"
    breadcrumbs={[{ name: "Home", path: "/" }, { name: "Personal Insurance", path: "/personal/" }]}
  />
  <body>
    <SkipMain />
    <header>
      <NavMain />
    </header>
    <main>
        <section class="hero-sub" role="banner">
            <div class="padding-hero">
                <div class="container">
                    <div class="wrapper-hero">
                        <AnimatedHeadline client:load>
                            Personal <span class="highlight">Insurance</span> in Arizona
                        </AnimatedHeadline>
                        <FadeInUp delay={0.5} duration={1} client:load>
                            <div class="wrapper-short">
                                <p class="body-regular">
                                  Moore Insurance helps Arizona residents compare insurance options for their homes, belongings, families, and personal liability. Based in Surprise, our independent agency works with multiple insurance companies to help you review available policies, coverage limits, deductibles, and rates.
                                </p>
                                <div class="wrapper-btn">
                                    <a class="btn" href="/quote/personal/">
                                        Get Your Free Quote
                                    </a>
                                    <a class="btn secondary" href="#coverage">
                                        See Coverage Options
                                    </a>
                                </div>
                            </div>
                        </FadeInUp>
                    </div>
                </div>
            </div>
        </section>
        <FadeInUp delay={0.125} duration={1} client:load>
            <section class="section-main">
              <div class="padding-section">
                <div class="container">
                  <div class="wrapper-col">
                    <div class="wrapper">
                      <h2 class="section-title">
                        Why Choose Moore Insurance
                        <br />
                        for <span class="highlight">Personal Coverage?</span>
                      </h2>
                      <FeatureItem
                        title="Coverage for Different Needs"
                        desc="Whether you own a home, rent, or want additional liability or life insurance, we help you review available policies based on your needs and priorities."
                      />
                      <FeatureItem
                        title="Compare Coverage and Costs"
                        desc="We explain premiums, deductibles, coverage limits, and exclusions so you can understand the differences between available insurance policies."
                      />
                      <FeatureItem
                        title="Local Agents, Ongoing Support"
                        desc="Our team in Surprise can answer policy questions, help you review changes, and explain the next steps when you need assistance with a claim."
                      />
                      <div class="wrapper-btn">
                        <a class="btn" href="/quote/personal/">
                          Get Your Quote
                        </a>
                        <a class="btn secondary" href="#coverage">
                          Coverage Options
                        </a>
                      </div>
                    </div>
                    <div class="wrapper-img">
                      <img class="img-reg" src="/images/static/family-1.webp" alt="A modern light rail train with a “TBOUND PHOENIX” sign approaches a station on a bustling city street, surrounded by tall reflective buildings." />
                    </div>
                </div>
              </div>
            </section>
        </FadeInUp>
        <FadeInUp delay={0} duration={1} client:load>
          <section id="coverage">
            <div class="padding-section">
                <div class="container">
                  <div class="wrapper-center">
                    <h2 class="section-title">
                      Explore Our <span class="highlight">Personal Insurance</span> Options
                    </h2>
                  </div>
                  <ServiceGrid
                    categoryFilter="Personal Coverage"
                    titleOverrides={{
                      "home-insurance": "Homeowners Insurance",
                      "personal-asset-coverage": "Valuable Personal Property Insurance",
                    }}
                  />
                  <div class="wrapper-btn center">
                    <a class="btn" href="/quote/personal/">Get Your Quote</a>
                  </div>
                </div>
            </div>
          </section>
        </FadeInUp>
        <FadeInUp delay={0.125} duration={1} client:load>
          <section>
            <div class="padding-section">
              <div class="container">
                <div class="wrapper-center">
                  <h2 class="section-title center">
                    What Does <span class="highlight">Personal Insurance</span> Include?
                  </h2>
                  <p class="body-regular center">
                    Personal insurance includes several types of policies designed to address different financial risks. Homeowners and renters insurance can cover certain losses involving property, belongings, and personal liability. Life insurance may provide a benefit to beneficiaries after the insured person's death, while umbrella insurance can offer additional liability coverage above qualifying underlying policies.
                  </p>
                  <p class="body-regular center">
                    Each policy serves a different purpose, and coverage depends on the insurer, policy terms, limits, and exclusions. Moore Insurance can help you compare available options and determine which types of coverage may be appropriate for your situation.
                  </p>
                </div>
              </div>
            </div>
          </section>
        </FadeInUp>
        <section class="city-bg">
          <div class="padding-section">
            <div class="container">
              <div class="wrapper-center">
                <h2 class="page-title center">
                  Compare <span class="highlight">Personal Insurance</span>
                  <br />
                  Options
                </h2>
                <div class="wrapper-btn short-padding">
                  <a class="btn" href="/quote/personal/">
                    Get Your Quote
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
        <FadeInUp delay={0.125} duration={1} client:load>
          <section>
            <div class="padding-section">
              <div class="container">
                <ReviewGrid
                />
                <div class="wrapper-center">
                  <div class="wrapper-btn">
                    <a class="btn" href="/quote/personal/">
                      Get Your Free Quote
                    </a>
                    <a class="btn secondary" href="https://www.google.com/search?client=opera&q=moore+insurance&sourceid=opera&ie=UTF-8&oe=UTF-8" target="_blank" rel="noopener noreferrer">                      Leave Us A Review
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </FadeInUp>
        <FadeInUp delay={0.125} duration={1} client:load>
          <div class="padding-section lg-bottom">
            <div class="container">
              <h2 class="section-title center">
                Get Your <span class="highlight">Free</span> Quote
              </h2>
              <FormPersonal
                coverageLabels={{
                  home: "Homeowners Insurance",
                  personalAsset: "Valuable Personal Property Insurance",
                  umbrella: "Umbrella Insurance",
                }}
              />
            </div>
          </div>
        </FadeInUp>
    </main>
    <FooterMain />
  </body>
