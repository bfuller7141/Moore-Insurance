---
import BaseHead from "../components/BaseHead.astro"
import SkipMain from "../components/SkipMain.astro"
import NavMain from "../components/NavMain.astro"
import AnimatedHeadline from "../components/Animations/AnimatedHeadline"
import FadeInUp from "../components/Animations/FadeInUp"
import FeatureItem from "../components/FeatureItem.astro"
import ServiceGrid from "../components/ServiceGrid.astro"
import ReviewGrid from "../components/ReviewGrid.astro"
import FooterMain from "../components/FooterMain.astro"
import FormAuto from "../components/FormAuto.astro"
---
<!DOCTYPE html>
<html lang="en">
  <BaseHead
    title="Auto & Vehicle Insurance in Arizona | Moore Insurance"
    description="Explore car, motorcycle, RV, golf cart and ATV insurance with Moore Insurance in Surprise, AZ. Compare vehicle coverage options with our local agents."
    image="https://moore-insurance.com/images/og-image.jpg"
  />
  <body>
    <SkipMain />
    <header>
      <NavMain />
    </header>
    <main>
        <section class="hero-sub-3" role="banner">
            <div class="padding-hero">
                <div class="container">
                    <div class="wrapper-hero">
                        <AnimatedHeadline client:load>
                            Auto & <span class="highlight">Vehicle Insurance</span> in Arizona
                        </AnimatedHeadline>
                        <FadeInUp delay={0.5} duration={1} client:load>
                            <div class="wrapper-short">
                                <p class="body-regular">
                                  Moore Insurance helps Arizona drivers compare insurance options for cars, motorcycles, RVs, golf carts, ATVs, and business vehicles. Based in Surprise, our independent agency works with multiple insurance companies to help you review available coverage, deductibles, and rates.
                                </p>
                                <div class="wrapper-btn">
                                    <a class="btn" href="/quote/auto/">
                                        Get Your Free Quote
                                    </a>
                                    <a class="btn secondary" href="#coverage">
                                        See Coverage Options
                                    </a>
                                </div>
                            </div>
                        </FadeInUp>
                    </div>
                </div>
            </div>
        </section>
        <FadeInUp delay={0.125} duration={1} client:load>
            <section class="section-main">
              <div class="padding-section">
                <div class="container">
                  <div class="wrapper-col">
                    <div class="wrapper">
                      <h2 class="section-title">
                        Why Choose Moore Insurance
                        <br />
                        for <span class="highlight">Vehicle Coverage?</span>
                      </h2>
                      <FeatureItem
                        title="Coverage for Different Vehicles"
                        desc="From everyday cars to recreational vehicles, we help you explore insurance options based on the vehicle you own and how you use it."
                      />
                      <FeatureItem
                        title="Compare Multiple Insurance Companies"
                        desc="As an independent agency, we compare available policies from multiple carriers so you can review rates, deductibles, and coverage options."
                      />
                      <FeatureItem
                        title="Local Agents, Ongoing Support"
                        desc="Our team in Surprise can answer policy questions, help with coverage changes, and explain the next steps when you need to file a claim."
                      />
                      <div class="wrapper-btn">
                        <a class="btn" href="/quote/auto/">
                          Get Your Quote
                        </a>
                        <a class="btn secondary" href="#coverage">
                          Coverage Options
                        </a>
                      </div>
                    </div>
                    <div class="wrapper-img">
                      <img class="img-reg" src="/images/static/car-1.webp" alt="A modern light rail train with a “TBOUND PHOENIX” sign approaches a station on a bustling city street, surrounded by tall reflective buildings." />
                    </div>
                </div>
              </div>
            </section>
        </FadeInUp>
        <FadeInUp delay={0} duration={1} client:load>
          <section id="coverage">
            <div class="padding-section">
                <div class="container">
                  <div class="wrapper-center">
                    <h2 class="section-title">
                      Explore Our <span class="highlight">Vehicle Insurance</span> Options
                    </h2>
                  </div>
                  <ServiceGrid
                    categoryFilter="Auto Coverage"
                    titleOverrides={{ "commercial-auto": "Commercial Auto Insurance" }}
                  />
                  <div class="wrapper-btn center">
                    <a class="btn" href="/quote/auto/">Get Your Quote</a>
                  </div>
                </div>
            </div>
          </section>
        </FadeInUp>
        <FadeInUp delay={0.125} duration={1} client:load>
          <section>
            <div class="padding-section">
              <div class="container">
                <div class="wrapper-center">
                  <h2 class="section-title center">
                    What Does <span class="highlight">Vehicle Insurance</span> Cover?
                  </h2>
                  <p class="body-regular center">
                    Vehicle insurance can help cover costs related to accidents, injuries, theft, and vehicle damage, depending on the policy. Available coverage varies by vehicle type and may include liability, collision, comprehensive, uninsured motorist, and other options. Cars, motorcycles, RVs, golf carts, ATVs, and commercial vehicles may have different insurance requirements and coverage options. Our agents can help you understand those differences and compare available policies.
                  </p>
                </div>
              </div>
            </div>
          </section>
        </FadeInUp>
        <section class="city-bg">
          <div class="padding-section">
            <div class="container">
              <div class="wrapper-center">
                <h2 class="page-title center">
                  Compare <span class="highlight">Vehicle Insurance</span>
                  <br />
                  Options
                </h2>
                <div class="wrapper-btn short-padding">
                  <a class="btn" href="/quote/auto/">
                    Get Your Free Quote
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
        <FadeInUp delay={0.125} duration={1} client:load>
          <section>
            <div class="padding-section">
              <div class="container">
                <ReviewGrid
                />
                <div class="wrapper-center">
                  <div class="wrapper-btn">
                    <a class="btn" href="/quote/auto/">
                      Get Your Quote
                    </a>
                    <a class="btn secondary" href="https://www.google.com/search?client=opera&q=moore+insurance&sourceid=opera&ie=UTF-8&oe=UTF-8" target="_blank" rel="noopener noreferrer">                      Leave Us A Review
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </FadeInUp>
        <FadeInUp delay={0.125} duration={1} client:load>
          <div class="padding-section lg-bottom">
            <div class="container">
              <h2 class="section-title center">
                Get Your <span class="highlight">Free</span> Quote
              </h2>
              <FormAuto />
            </div>
          </div>
        </FadeInUp>
    </main>
    <FooterMain />
  </body>
