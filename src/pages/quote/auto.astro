---
import FadeInUp from "../../components/Animations/FadeInUp";
import BaseHead from "../../components/BaseHead.astro";
import FormAuto from "../../components/FormAuto.astro";
import NavMain from "../../components/NavMain.astro";
import SkipMain from "../../components/SkipMain.astro";
---

<!DOCTYPE html>
<html lang="en">
  <BaseHead
    title="Auto Insurance Quote | Moore Insurance"
    description="Request an auto insurance quote from Moore Insurance in Surprise, Arizona. Share your driver and vehicle details to compare available coverage options."
    image="/images/static/car-insurance.webp"
    pageType="ContactPage"
    breadcrumbs={[{ name: "Home", path: "/" }, { name: "Auto Insurance", path: "/auto/" }, { name: "Request a Quote", path: "/quote/auto/" }]}
  />
  <body>
    <SkipMain />
    <header>
      <NavMain />
    </header>
    <main>
      <section role="banner">
        <div class="padding-hero">
          <div class="container">
            <div class="wrapper-center">
                <FadeInUp delay={0.125} duration={1} client:load>
                    <h1 class="page-title center">
                        Request an <span class="highlight">Auto Insurance</span> Quote
                    </h1>
                </FadeInUp>
                <FadeInUp delay={0.25} duration={1} client:load>
                    <FormAuto />
                </FadeInUp>
            </div>
        </div>
      </section>
