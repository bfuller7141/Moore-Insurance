---
import FadeInUp from "../../components/Animations/FadeInUp";
import BaseHead from "../../components/BaseHead.astro";
import FormPersonal from "../../components/FormPersonal.astro";
import NavMain from "../../components/NavMain.astro";
import SkipMain from "../../components/SkipMain.astro";
---

<!DOCTYPE html>
<html lang="en">
  <BaseHead
    title="Personal Insurance Quote | Moore Insurance"
    description="Request a personal insurance quote from Moore Insurance in Surprise, Arizona. Share your coverage needs so our local agents can review available options."
    image="/images/static/home-insurance.webp"
    pageType="ContactPage"
    breadcrumbs={[{ name: "Home", path: "/" }, { name: "Personal Insurance", path: "/personal/" }, { name: "Request a Quote", path: "/quote/personal/" }]}
  />
  <body>
    <SkipMain />
    <header>
      <NavMain />
    </header>
    <main>
      <section role="banner">
        <div class="padding-hero">
          <div class="container">
            <div class="wrapper-center">
                <FadeInUp delay={0.125} duration={1} client:load>
                    <h1 class="page-title center">
                        Request a <span class="highlight">Personal Insurance</span> Quote
                    </h1>
                </FadeInUp>
                <FadeInUp delay={0.25} duration={1} client:load>
                    <FormPersonal />
                </FadeInUp>
            </div>
        </div>
      </section>
