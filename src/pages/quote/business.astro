---
import FadeInUp from "../../components/Animations/FadeInUp";
import BaseHead from "../../components/BaseHead.astro";
import FormBusiness from "../../components/FormBusiness.astro";
import NavMain from "../../components/NavMain.astro";
import SkipMain from "../../components/SkipMain.astro";
---

<!DOCTYPE html>
<html lang="en">
  <BaseHead
    title="Business Insurance Quote | Moore Insurance"
    description="Request a business insurance quote from Moore Insurance in Surprise, Arizona. Tell our agents about your company and the coverage you need."
    image="/images/static/business-insurance.webp"
    pageType="ContactPage"
    breadcrumbs={[{ name: "Home", path: "/" }, { name: "Business Insurance", path: "/business/" }, { name: "Request a Quote", path: "/quote/business/" }]}
  />
  <body>
    <SkipMain />
    <header>
      <NavMain />
    </header>
    <main>
      <section role="banner">
        <div class="padding-hero">
          <div class="container">
            <div class="wrapper-center">
                <FadeInUp delay={0.125} duration={1} client:load>
                    <h1 class="page-title center">
                        Request a <span class="highlight">Business Insurance</span> Quote
                    </h1>
                </FadeInUp>
                <FadeInUp delay={0.25} duration={1} client:load>
                    <FormBusiness />
                </FadeInUp>
            </div>
        </div>
      </section>
