---
import FadeInUp from "../../components/Animations/FadeInUp";
import BaseHead from "../../components/BaseHead.astro";
import FormGeneral from "../../components/FormGeneral.astro";
import NavMain from "../../components/NavMain.astro";
import SkipMain from "../../components/SkipMain.astro";
---

<!DOCTYPE html>
<html lang="en">
  <BaseHead
    title="Request an Insurance Quote | Moore Insurance"
    description="Request a personalized insurance quote from Moore Insurance in Surprise, Arizona. Tell our local team what type of coverage you need to get started."
    image="/images/backgrounds/home-hero.webp"
    pageType="ContactPage"
    breadcrumbs={[{ name: "Home", path: "/" }, { name: "Request a Quote", path: "/quote/general/" }]}
  />
  <body>
    <SkipMain />
    <header>
      <NavMain />
    </header>
    <main>
      <section role="banner">
        <div class="padding-hero">
          <div class="container">
            <div class="wrapper-center">
                <FadeInUp delay={0.125} duration={1} client:load>
                    <h1 class="page-title center">
                        Request an <span class="highlight">Insurance</span> Quote
                    </h1>
                </FadeInUp>
                <FadeInUp delay={0.25} duration={1} client:load>
                    <FormGeneral />
                </FadeInUp>
            </div>
        </div>
      </section>
