---
import "../styles/root.css";
import "../styles/main-styles.css";

type SchemaNode = Record<string, unknown>;

interface BreadcrumbItem {
  name: string;
  path: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  pageType?: "WebPage" | "AboutPage" | "CollectionPage" | "ContactPage";
  breadcrumbs?: BreadcrumbItem[];
  faqs?: FAQItem[];
  structuredData?: SchemaNode | SchemaNode[];
  primaryEntityId?: string;
  googleSiteVerification?: string;
}

const {
  title = "Moore Insurance Agency",
  description = "Independent insurance agency in Surprise, Arizona, helping families and businesses compare coverage from multiple insurance companies.",
  image = "/images/backgrounds/home-hero.webp",
  pageType = "WebPage",
  breadcrumbs = [],
  faqs = [],
  structuredData = [],
  primaryEntityId,
  googleSiteVerification,
} = Astro.props as Props;

const siteUrl = Astro.site ?? new URL("https://www.mooreinsure.net");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const homeUrl = new URL("/", siteUrl).href;
const organizationId = `${homeUrl}#organization`;
const websiteId = `${homeUrl}#website`;
const webpageId = `${canonicalUrl}#webpage`;
const imageUrl = new URL(image, siteUrl).href;
const breadcrumbId = `${canonicalUrl}#breadcrumb`;
const isHomePage = Astro.url.pathname === "/";

const organization: SchemaNode = {
  "@type": "InsuranceAgency",
  "@id": organizationId,
  name: "Moore Insurance Agency LLC",
  alternateName: "Moore Insurance",
  url: homeUrl,
  logo: {
    "@type": "ImageObject",
    url: new URL("/images/logo.svg", siteUrl).href,
  },
  image: new URL("/images/backgrounds/home-hero.webp", siteUrl).href,
  description: "Independent insurance agency in Surprise, Arizona, helping individuals, families, and businesses compare insurance coverage from multiple carriers.",
  telephone: "+1-623-556-1576",
  email: "helen@mooreinsure.net",
  address: {
    "@type": "PostalAddress",
    streetAddress: "15282 W Brookside Ln, Suite 110",
    addressLocality: "Surprise",
    addressRegion: "AZ",
    postalCode: "85374",
    addressCountry: "US",
  },
  areaServed: {
    "@type": "AdministrativeArea",
    name: "Arizona",
  },
  openingHoursSpecification: [{
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "09:00",
    closes: "17:00",
  }],
  sameAs: ["https://www.facebook.com/Moore.Insure"],
};

const website: SchemaNode = {
  "@type": "WebSite",
  "@id": websiteId,
  url: homeUrl,
  name: "Moore Insurance Agency",
  alternateName: "Moore Insurance",
  publisher: { "@id": organizationId },
  inLanguage: "en-US",
};

const webpage: SchemaNode = {
  "@type": pageType,
  "@id": webpageId,
  url: canonicalUrl,
  name: title,
  description,
  isPartOf: { "@id": websiteId },
  about: { "@id": organizationId },
  publisher: { "@id": organizationId },
  primaryImageOfPage: {
    "@type": "ImageObject",
    url: imageUrl,
  },
  inLanguage: "en-US",
  ...(breadcrumbs.length > 0 ? { breadcrumb: { "@id": breadcrumbId } } : {}),
  ...(primaryEntityId ? { mainEntity: { "@id": primaryEntityId } } : {}),
};

const breadcrumbSchema: SchemaNode[] = breadcrumbs.length > 0
  ? [{
      "@type": "BreadcrumbList",
      "@id": breadcrumbId,
      itemListElement: breadcrumbs.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: new URL(item.path, siteUrl).href,
      })),
    }]
  : [];

const faqSchema: SchemaNode[] = faqs.length > 0
  ? [{
      "@type": "FAQPage",
      "@id": `${canonicalUrl}#faq`,
      url: canonicalUrl,
      isPartOf: { "@id": webpageId },
      mainEntity: faqs.map(({ question, answer }) => ({
        "@type": "Question",
        name: question,
        acceptedAnswer: {
          "@type": "Answer",
          text: answer,
        },
      })),
    }]
  : [];

const additionalSchema = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    organization,
    ...(isHomePage ? [website] : []),
    webpage,
    ...breadcrumbSchema,
    ...faqSchema,
    ...additionalSchema,
  ],
};
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="description" content={description} />
  {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
  <link rel="canonical" href={canonicalUrl} />
  <link rel="describedby" href="/llms.txt" type="text/markdown" />

  <!-- Open Graph / Social Tags -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:type" content="website" />

  <!-- Fonts -->
  <link rel="preload" href="https://use.typekit.net/xti7dmv.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
  <noscript><link rel="stylesheet" href="https://use.typekit.net/xti7dmv.css" /></noscript>
  <link rel="preconnect" href="https://use.typekit.net" crossorigin />
  <link rel="preconnect" href="https://p.typekit.net" crossorigin />

  <!-- JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Favicon -->
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Preload -->
  <link rel="preload" as="image" href="/images/backgrounds/home-hero.webp" />
  <link rel="preload" as="image" href="/images/backgrounds/sub hero-1.webp" />
  <link rel="preload" as="image" href="/images/backgrounds/sub hero-2.webp" />
  <link rel="preload" as="image" href="/images/backgrounds/sub hero-3.webp" />
</head>
